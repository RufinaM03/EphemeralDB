APP_ENV=local
AWS_REGION=ap-south-1
AWS_PROFILE=
WAL_STORE=local
WAL_PERSISTENCE_MODE=single
S3_EXPRESS_BUCKET=
S3_EXPRESS_ZONE_ID=
S3_EXPRESS_PREFIX=wal
# Separate existing general-purpose bucket; never an S3 Express directory bucket.
S3_CHECKPOINT_BUCKET=
S3_CHECKPOINT_PREFIX=checkpoints
# Phase 8 control objects use S3_CHECKPOINT_PREFIX/control in this general-purpose bucket.
# Fenced namespaces must be fresh; RUN_AWS_TESTS=1 is required for chargeable verification.
WAL_BATCH_WINDOW_MS=5
WAL_BATCH_MAX_RECORDS=100
WAL_BATCH_MAX_BYTES=1048576
WAL_BATCH_MAX_QUEUE_RECORDS=10000
WAL_BATCH_FLUSH_ON_SHUTDOWN=true
AWS_CONNECT_TIMEOUT_SECONDS=3
AWS_READ_TIMEOUT_SECONDS=10
AWS_MAX_ATTEMPTS=3
AWS_RETRY_MODE=standard
CACHE_DIR=/cache
LOG_LEVEL=INFO
BENCHMARK_SEED=42

# Experiment console: local defaults make no AWS calls.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8765
CONSOLE_DATA_DIR=.artifacts/console
CONSOLE_WEB_DIR=frontend/build/web
# Required for access beyond localhost. Never commit tokens or DSNs.
CONSOLE_TOKEN=
ENABLE_AWS_EXECUTION=0
# PostgreSQL libpq DSN; use sslmode=verify-full and the AWS CA bundle on Aurora.
AURORA_DSN=
# Fixed comma-separated per-pod URLs, never a load-balanced endpoint.
RUNTIME_URLS=
RUNTIME_TOKEN=
# Only dedicated, reviewed AWS FIS experiment-template IDs.
FIS_TEMPLATE_IDS=
